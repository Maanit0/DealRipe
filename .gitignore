# Any local copy of environment variables, whatever it is called. `vercel env
# pull` writes real production secrets to whatever filename you give it, and
# ".env.production.check" matched none of the patterns above. It sat untracked
# in the working tree, one `git add -A` from being committed.
.env
.env.*
!.env.example
.DS_Store
next-env.d.ts
.vercel
*.mov
*.mp4

# Saved call transcripts (customer/NDA data, never commit)
.transcripts/

# Rendered email/preview HTML (may contain customer-derived content)
.previews/
dealripe-sf.key

# Generated email previews, rewritten on every script run.
welcome-preview.html
digest-preview.html
digest-generated.html

# Local Claude Code tool permissions, per-machine.
.claude/
